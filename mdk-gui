"""mdk-gui: friendly desktop front-end for the MUN Devkit. See docs/gui.md."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "tools"))

try:
    from gui.app import main  # after the path above, on purpose
except ModuleNotFoundError as exc:
    name = getattr(exc, "name", "") or str(exc)
    if "tkinter" in name or "_tkinter" in name:
        print("MUN Devkit needs Python Tk.", file=sys.stderr)
        print("In Ubuntu run:  sudo apt update && sudo apt install -y python3-tk",
              file=sys.stderr)
        raise SystemExit(2) from exc
    raise

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
